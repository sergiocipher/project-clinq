# Copy this file to .env for local development.
# NEVER commit .env — it is listed in .gitignore.
# All values here are obviously fake and safe to commit.

POSTGRES_DB=clinqdb
POSTGRES_USER=clinquser
POSTGRES_PASSWORD=change-me-local-only

# psycopg v3 connection string used by the backend
# Note: use @postgres (Docker service name) when running with docker compose,
# or @localhost when connecting directly from outside Docker.
DATABASE_URL=postgresql+psycopg://clinquser:change-me-local-only@postgres:5432/clinqdb

APP_VERSION=dev
