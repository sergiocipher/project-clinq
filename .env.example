# Copy this file to .env for local development.
# NEVER commit .env — it is listed in .gitignore.
# All values here are obviously fake and safe to commit.

POSTGRES_DB=clinqdb
POSTGRES_USER=clinquser
POSTGRES_PASSWORD=change-me-local-only

# psycopg v3 connection string used by the backend
DATABASE_URL=postgresql+psycopg://clinquser:change-me-local-only@localhost:5432/clinqdb

APP_VERSION=dev
