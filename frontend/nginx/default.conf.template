# WHY THIS FILE EXISTS:
# Nginx config template — using a template (not a static .conf) lets us
# inject BACKEND_URL at container startup via envsubst. This means we can
# point the same image at different backend addresses in different environments
# (docker-compose, Kubernetes) without rebuilding.
# The unprivileged Nginx image listens on port 8080 (not 80) because ports
# below 1024 require root privileges.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback: unknown paths serve index.html so React Router works
    location / {
        try_files $uri /index.html;
    }

    # Proxy /api/ requests to the backend service
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
